<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ArcGIS Pro MCP Bridge add-in.
    Built against the ArcGIS Pro 3.0 SDK (net6.0-windows) on purpose: an add-in compiled
    for 3.0 is forward compatible with every ArcGIS Pro 3.x release (3.0 ... 3.7+),
    including 3.5+ which runs on .NET 8.
  -->
  <PropertyGroup>
    <TargetFramework>net6.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>ArcGISProMcpBridge</RootNamespace>
    <AssemblyName>ArcGISProMcpBridge</AssemblyName>
    <Version>1.0.0</Version>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <NoWarn>$(NoWarn);CA1416;NU1701;NETSDK1138;CS1998</NoWarn>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- ExcludeAssets="build": Esri's packaging task uses CodeTaskFactory (not supported by dotnet CLI); we package below. -->
    <PackageReference Include="Esri.ArcGISPro.Extensions30" Version="3.0.0.36056" ExcludeAssets="build" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Config.daml" />
    <Content Include="Images\AddinDesktop16.png" />
    <Content Include="Images\AddinDesktop32.png" />
    <EmbeddedResource Include="Python\McpRunner.pyt" LogicalName="McpRunner.pyt" />
  </ItemGroup>

  <!-- Build the .esriAddinX package (zip: Config.daml + Images\ + Install\*.dll) -->
  <Target Name="PackageEsriAddinX" AfterTargets="Build">
    <PropertyGroup>
      <AddinStage>$(IntermediateOutputPath)addin_stage\</AddinStage>
      <AddinOut>$(OutDir)$(AssemblyName).esriAddinX</AddinOut>
    </PropertyGroup>
    <RemoveDir Directories="$(AddinStage)" />
    <Copy SourceFiles="Config.daml" DestinationFolder="$(AddinStage)" />
    <Copy SourceFiles="Images\AddinDesktop16.png;Images\AddinDesktop32.png" DestinationFolder="$(AddinStage)Images" />
    <Copy SourceFiles="$(OutDir)$(AssemblyName).dll" DestinationFolder="$(AddinStage)Install" />
    <Delete Files="$(AddinOut)" />
    <ZipDirectory SourceDirectory="$(AddinStage)" DestinationFile="$(AddinOut)" Overwrite="true" />
    <Message Importance="high" Text="Add-in package: $(AddinOut)" />
  </Target>

</Project>
